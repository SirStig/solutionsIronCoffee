# Copy to .env.deploy and fill in. .env.deploy is gitignored, this file is not,
# so keep real hostnames out of it.
# `npm run deploy` reads .env.deploy; the real environment overrides it.

DEPLOY_USER=dh_user
DEPLOY_HOST=vpsNNNNN.dreamhostps.com

# The domain directory in the login's home. Relative paths resolve there.
DEPLOY_PATH=solutions.ironcoffee.com

# Optional.
# DEPLOY_PORT=22
# DEPLOY_SSH_KEY=~/.ssh/id_ed25519
