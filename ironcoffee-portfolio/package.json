{
  "name": "ironcoffee-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@sentry/react": "^9.2.0",
    "lucide-react": "^0.552.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-ga4": "^2.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.2.0",
    "web-vitals": "^2.1.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^26.2.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "jsdom": "^25.0.0",
    "marked": "^18.0.10",
    "playwright": "^1.62.1",
    "sharp": "^0.35.3",
    "shiki": "^4.4.3",
    "typescript": "^5.9.3",
    "vite": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run optimize:media",
    "build": "npm run optimize:media && vite build && npm run build:ssr && node scripts/prerender.mjs",
    "build:ssr": "vite build --ssr src/entry-server.tsx --outDir .ssr-build --emptyOutDir",
    "optimize:media": "node scripts/optimize-media.mjs",
    "generate:brand": "node scripts/generate-brand.mjs",
    "serve": "node scripts/serve.mjs",
    "test": "vitest run",
    "pretest": "npm run optimize:media",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run optimize:media",
    "verify": "node scripts/verify-deploy.js"
  }
}
