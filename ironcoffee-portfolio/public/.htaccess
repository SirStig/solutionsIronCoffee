# IronCoffee Solutions: Apache config for Dreamhost.
# The build prerenders every route to <route>/index.html, so most requests are
# served as static files and never touch the SPA fallback.

<IfModule mod_rewrite.c>
  Options -MultiViews
  RewriteEngine On
  RewriteBase /

  # Force HTTPS.
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Canonical host: strip www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

  # --- Demo subdomains -----------------------------------------------------
  # sammieds.ironcoffee.com serves the page built at /demo/sammieds/.
  #
  # The negative tests come first on purpose: %1 has to be captured by the last
  # regex condition in the chain, or the backreference the rule reads will have
  # been overwritten by the time it runs. The -f test that follows does no
  # matching of its own, so the capture survives it.
  RewriteCond %{HTTP_HOST} !^ironcoffee\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(www|solutions|api|mail|smtp|imap|pop|webmail|ftp|cdn|ns[0-9]*)\.ironcoffee\.com$ [NC]
  RewriteCond %{HTTP_HOST} ^([a-z0-9][a-z0-9-]*)\.ironcoffee\.com$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/demo/%1/index.html -f
  RewriteRule ^/?$ /demo/%1/index.html [L]

  # Interior pages of a multi-page preview: sammieds.ironcoffee.com/menu is
  # the page built at /demo/sammieds/menu/.
  #
  # Without this, only the front page of a preview worked on its own
  # subdomain and every nav link landed on the catch-all at the bottom of this
  # file. That used to serve the SPA shell, which rendered the client-side 404
  # under the business's own domain name; now it would answer a real 404. Both
  # are wrong, and neither shows up until you send someone a link.
  #
  # `%1` is the subdomain from the host conditions, `$1` the first path
  # segment from the rule. The pattern excludes anything with a dot in it, so
  # hashed asset filenames stay with the -f rule further down.
  RewriteCond %{HTTP_HOST} !^ironcoffee\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(www|solutions|api|mail|smtp|imap|pop|webmail|ftp|cdn|ns[0-9]*)\.ironcoffee\.com$ [NC]
  RewriteCond %{HTTP_HOST} ^([a-z0-9][a-z0-9-]*)\.ironcoffee\.com$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/demo/%1/$1/index.html -f
  RewriteRule ^([a-z0-9][a-z0-9-]*)/?$ /demo/%1/$1/index.html [L]

  # A subdomain with no demo behind it has to stop here. Without this it falls
  # through to the SPA shell at the bottom of this file and quietly serves the
  # portfolio from someone else's business name.
  RewriteCond %{HTTP_HOST} !^ironcoffee\.com$ [NC]
  RewriteCond %{HTTP_HOST} !^(www|solutions|api|mail|smtp|imap|pop|webmail|ftp|cdn|ns[0-9]*)\.ironcoffee\.com$ [NC]
  RewriteCond %{HTTP_HOST} ^([a-z0-9][a-z0-9-]*)\.ironcoffee\.com$ [NC]
  RewriteCond %{DOCUMENT_ROOT}/demo/%1/index.html !-f
  RewriteRule ^ - [R=404,L]

  # --- Permanent moves from the previous site structure --------------------
  RewriteRule ^portfolio/?$ /work [R=301,L]
  RewriteRule ^portfolio/(.+?)/?$ /work/$1 [R=301,L]

  # Drop trailing slashes so each page has exactly one canonical URL.
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # Serve the prerendered page for a clean URL: /work/beyond25 →
  # /work/beyond25/index.html.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ /$1/index.html [L]

  # Anything still unmatched is a genuine 404, and has to answer with one.
  #
  # This used to serve /index.html, which meant a mistyped or deleted URL came
  # back 200 OK carrying the app shell, and the "not found" page only appeared
  # once JavaScript had run. A crawler sees the status line, not the render, so
  # every dead URL on the site looked alive: soft 404s stay indexed, Search
  # Console cannot report a removed page, and crawl budget goes on nothing.
  #
  # Aborting here is safe precisely because every real route is prerendered to
  # its own index.html and was already claimed by the rule above. Falling this
  # far means there is nothing to serve, and ErrorDocument below hands over the
  # styled 404 page with the right status on it.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

ErrorDocument 404 /404.html

# --- Caching ---------------------------------------------------------------
# Hashed assets are immutable and cached for a year. HTML must never be, or a
# deploy leaves visitors on a stale page pointing at deleted asset filenames.
<IfModule mod_headers.c>
  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(avif|webp|png|jpe?g|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(xml|txt|json)$">
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # --- Security ------------------------------------------------------------
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

  # Everything is self-hosted; the only outbound calls are the analytics and
  # error-tracking endpoints and the package registries the version badges read.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://*.ingest.sentry.io https://pypi.org https://registry.npmjs.org https://api.github.com https://api.emailjs.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://api.emailjs.com"
</IfModule>

# --- Compression -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css
  AddOutputFilterByType DEFLATE application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml application/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml

  # text/javascript, not just application/javascript. Modern Apache serves .js
  # as text/javascript, so the line above matched nothing and every script on
  # the site went out uncompressed: about 440 KB where 130 KB would do. The old
  # type stays listed because some hosts still use it.
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/manifest+json
  AddOutputFilterByType DEFLATE image/x-icon

  # woff2 and AVIF are compressed formats already. Running deflate over them
  # spends CPU to make them very slightly larger.
</IfModule>

# AVIF and WebP need explicit types on some Dreamhost configs.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>
